# 云端机器人配置：复制成 .env，按需改
# 这个文件里除了 API key 与备份 token，其他基本不用动

# ── 云端「大脑」（必填）───────────────────────────────────────────────
# 建议单独申请一把 DeepSeek API key（sk-…），不要复用桌面端 DSH 的账号令牌
DEEPSEEK_API_KEY=
# 任何 OpenAI 兼容端点都行，例：https://api.deepseek.com/v1 / https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── OneBot 连接（NapCat 同一台机器就是默认值）──────────────────────────
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_TOKEN=
# 桌宠实例 id（云端只有一只，保持 main）
PET_ID=main

# ── 记忆备份服务（本机拉取用；留空 = 不启动备份服务）────────────────────
# 生成一串长随机字符：openssl rand -hex 24
BACKUP_TOKEN=
BACKUP_PORT=3020
BACKUP_HOST=127.0.0.1
# 每份快照间隔（毫秒），默认 6 小时；保留最近 72 份
BACKUP_INTERVAL_MS=21600000

# 时区（时间背景用）
TZ=Asia/Shanghai
